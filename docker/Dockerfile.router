FROM frrouting/frr:latest

# Userland diagnostic toolbox (FRR base image is intentionally minimal).
RUN apk add --no-cache \
    tcpdump \
    traceroute \
    netcat-openbsd \
    iperf3 \
    nmap \
    bash \
    curl

# Enable bgpd, ospfd, ldpd (MPLS) and bfdd (fast failover) by default.
# The base image ships /etc/frr/daemons with most daemons set to "no";
# flip the four we actually want on. Using sed substitution rather than
# echo so we don't clobber any other settings the upstream file carries.
RUN sed -i \
    -e 's/^bgpd=.*/bgpd=yes/' \
    -e 's/^ospfd=.*/ospfd=yes/' \
    -e 's/^ldpd=.*/ldpd=yes/' \
    -e 's/^bfdd=.*/bfdd=yes/' \
    /etc/frr/daemons

# MPLS readiness — tell the kernel to allocate a label table on every
# interface. Dropped into /etc/sysctl.d so anything that runs `sysctl
# --system` at startup picks it up; containerlab's exec hooks can also
# `sysctl -p /etc/sysctl.d/99-mpls.conf` if needed.
RUN printf 'net.mpls.platform_labels=100000\n' > /etc/sysctl.d/99-mpls.conf
